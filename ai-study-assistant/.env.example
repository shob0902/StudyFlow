# Template for .env: one Groq API key per graph node in graph order (key 5 is the generate_quiz backup).
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=your_groq_api_key_here
GROQ_API_KEY_3=your_groq_api_key_here
GROQ_API_KEY_4=your_groq_api_key_here
GROQ_API_KEY_5=your_groq_api_key_here
GROQ_API_KEY_6=your_groq_api_key_here
GROQ_API_KEY_7=your_groq_api_key_here
GROQ_API_KEY_8=your_groq_api_key_here

# Google OAuth 2.0 credentials from https://console.cloud.google.com/apis/credentials.
# Placeholders only - never commit real credentials. The client secret stays on the server.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Must match an Authorized redirect URI on the OAuth client, exactly.
GOOGLE_REDIRECT_URI=http://localhost:8501
# Optional: how long a signed-in session lasts, in minutes (default 720).
AUTH_SESSION_TTL_MINUTES=720
# Recommended for any hosted deployment: a Postgres connection string (free tier at https://neon.tech).
# When set, users, history, mastery, sign-ins and paused quizzes are stored there and survive
# restarts and redeploys. Leave it empty to use the local SQLite files below.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional: maximum pooled Postgres connections per process (default 5).
# DB_POOL_SIZE=5
# Optional: where the SQLite database file lives when DATABASE_URL is empty (default study_assistant.db).
STUDY_DB_PATH=study_assistant.db
